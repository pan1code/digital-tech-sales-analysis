# 6. XML — каталог магазина GIX

GIX_INDEX = "https://gix.ru/sitemap.xml"
GIX_PRODUCTS = "https://gix.ru/sitemap-iblock-4.xml"

index_response = requests.get(
    GIX_INDEX, headers=HEADERS, timeout=60
)
index_response.raise_for_status()
index_root = ET.fromstring(index_response.content)

product_response = requests.get(
    GIX_PRODUCTS, headers=HEADERS, timeout=60
)
product_response.raise_for_status()
product_root = ET.fromstring(product_response.content)

NS = {"sm": "http://www.sitemaps.org/schemas/sitemap/0.9"}

sitemaps = [
    node.text
    for node in index_root.findall(".//sm:loc", NS)
]

xml_rows = []

for url_node in product_root.findall("sm:url", NS):
    xml_rows.append({
        "url": url_node.findtext("sm:loc", namespaces=NS),
        "lastmod": url_node.findtext("sm:lastmod", namespaces=NS)
    })

gix_xml = pd.DataFrame(xml_rows)

gix_xml["lastmod"] = pd.to_datetime(
    gix_xml["lastmod"], errors="coerce"
)

print("Дочерние XML:", len(sitemaps))
print("URL в каталоге:", len(gix_xml))

display(gix_xml.head())


# 7. Проверка категорий в XML

gix_patterns = {
    "Смартфоны": r"/smartfon|/iphone_",
    "Планшеты": r"/planshet|/ipad_",
    "Ноутбуки": r"/noutbuk|/macbook",
    "Настольные компьютеры": r"/imac|/mac_mini|/mac_studio",
    "Игровые приставки": (
        r"/igrovye_pristavki|/pristavki_xbox|"
        r"playstation|nintendo_switch"
    )
}

xml_coverage = []

for category, pattern in gix_patterns.items():
    mask = gix_xml["url"].str.contains(
        pattern, case=False, regex=True, na=False
    )

    mask &= ~gix_xml["url"].str.contains(
        r"videoigry|aksessuar|gamepad",
        case=False,
        regex=True,
        na=False
    )

    xml_coverage.append({
        "category": category,
        "url_count": int(mask.sum())
    })

xml_coverage = pd.DataFrame(xml_coverage)

display(xml_coverage)

assert xml_coverage["url_count"].gt(0).all()


# 8. API Wildberries — получение JSON

WB_URLS = [
    "https://search.wb.ru/exactmatch/ru/common/v4/search",
    "https://www.wildberries.ru/__internal/search/exactmatch/ru/common/v18/search"
]

WB_QUERIES = {
    "Ноутбуки": "ноутбук",
    "Планшеты": "планшет",
    "Настольные компьютеры": "настольный компьютер системный блок",
    "Игровые приставки": "игровая приставка консоль",
    "Смартфоны": "смартфон"
}

def wb_search(query, page=1):
    params = {
        "appType": 1,
        "curr": "rub",
        "dest": -1257786,
        "lang": "ru",
        "page": page,
        "query": query,
        "resultset": "catalog",
        "sort": "popular",
        "spp": 30,
        "suppressSpellcheck": "false"
    }

    last_error = None

    for endpoint in WB_URLS:
        try:
            response = requests.get(
                endpoint,
                params=params,
                headers={
                    **HEADERS,
                    "Referer": "https://www.wildberries.ru/"
                },
                timeout=40
            )

            response.raise_for_status()

            payload = response.json()

            products = (
                payload.get("products")
                or payload.get("data", {}).get("products")
                or []
            )

            return endpoint, payload, products, None

        except Exception as exc:
            last_error = f"{type(exc).__name__}: {exc}"

    return None, None, [], last_error


api_rows = []
api_status = []

for category, query in WB_QUERIES.items():
    endpoint, payload, products, error = wb_search(query)

    api_status.append({
        "category": category,
        "rows": len(products),
        "endpoint": endpoint,
        "error": error
    })

    for product in products:
        price_obj = (
            (product.get("sizes") or [{}])[0].get("price")
            or {}
        )

        price = (
            price_obj.get("product")
            or price_obj.get("basic")
        )

        api_rows.append({
            "category": category,
            "product_id": product.get("id"),
            "name": product.get("name"),
            "brand": product.get("brand"),
            "price_rub": (
                price / 100
                if isinstance(price, (int, float))
                else np.nan
            ),
            "rating": product.get("rating"),
            "feedbacks": product.get("feedbacks")
        })

wb_products = pd.DataFrame(api_rows)

display(pd.DataFrame(api_status))

if not wb_products.empty:
    display(wb_products.head(10))

    display(
        wb_products.groupby("category").agg(
            товаров=("product_id", "nunique"),
            брендов=("brand", "nunique"),
            медианная_цена=("price_rub", "median"),
            медиана_отзывов=("feedbacks", "median")
        ).round(2)
    )

else:
    print("API Wildberries недоступен из текущей сети.")


# 9. HTML — неструктурированные данные GIX

text_rows = []

for category, pattern in gix_patterns.items():
    mask = gix_xml["url"].str.contains(
        pattern, case=False, regex=True, na=False
    )

    mask &= ~gix_xml["url"].str.contains(
        r"videoigry|aksessuar|gamepad",
        case=False,
        regex=True,
        na=False
    )

    candidates = gix_xml.loc[mask, "url"]
    candidates = candidates[candidates.str.count("/").ge(5)]

    if candidates.empty:
        text_rows.append({
            "category": category,
            "url": None,
            "title": None,
            "text": None
        })
        continue

    url = candidates.iloc[0]

    response = requests.get(
        url, headers=HEADERS, timeout=60
    )
    response.raise_for_status()

    soup = BeautifulSoup(response.text, "html.parser")

    for tag in soup(["script", "style", "noscript"]):
        tag.decompose()

    visible_text = " ".join(
        soup.get_text(" ", strip=True).split()
    )

    text_rows.append({
        "category": category,
        "url": url,
        "title": (
            soup.title.get_text(" ", strip=True)
            if soup.title else None
        ),
        "text": visible_text[:1500]
    })

gix_texts = pd.DataFrame(text_rows)

gix_texts["text_length"] = gix_texts["text"].str.len()

display(gix_texts[[
    "category", "title", "url", "text_length"
]])

display(gix_texts[["category", "text"]])


