# 3. 1С — реальные продажи игровых приставок

HF_BASE = (
    "https://huggingface.co/datasets/OPT-Bench/OPT-Bench/"
    "resolve/main/example_tasks/"
    "competitive-data-science-predict-future-sales"
)

dir_1c = RAW_DIR / "1c_sales"
dir_1c.mkdir(exist_ok=True)

files_1c = [
    "sales_train.csv",
    "items.csv",
    "item_categories.csv",
    "shops.csv"
]

for filename in files_1c:
    download(
        f"{HF_BASE}/{filename}?download=true",
        dir_1c / filename
    )

sales = pd.read_csv(dir_1c / "sales_train.csv")
items = pd.read_csv(dir_1c / "items.csv")
categories = pd.read_csv(dir_1c / "item_categories.csv")
shops = pd.read_csv(dir_1c / "shops.csv")

sales["sale_date"] = pd.to_datetime(
    sales["date"], format="%d.%m.%Y", errors="coerce"
)

hardware_categories = categories.loc[
    categories["item_category_name"].str.match(
        r"^Игровые консоли\s*-", na=False
    )
].copy()

console_sales = (
    sales
    .merge(items, on="item_id", how="left", validate="many_to_one")
    .merge(
        hardware_categories,
        on="item_category_id",
        how="inner",
        validate="many_to_one"
    )
    .merge(shops, on="shop_id", how="left", validate="many_to_one")
)

def console_brand(category):
    text = str(category).upper()

    if re.search(r"PS2|PS3|PS4|PSP|PSVITA", text):
        return "Sony"

    if "XBOX" in text:
        return "Microsoft"

    return "Другой/не указан"

city_corrections = {
    "Н.Новгород": "Нижний Новгород",
    "РостовНаДону": "Ростов-на-Дону",
    "СПб": "Санкт-Петербург",
    "Интернет-магазин": "Онлайн"
}

console_sales["city"] = (
    console_sales["shop_name"]
    .str.replace(r"^!", "", regex=True)
    .str.split()
    .str[0]
    .replace(city_corrections)
)

console_sales["brand"] = (
    console_sales["item_category_name"].map(console_brand)
)

console_sales["category"] = "Игровые приставки"
console_sales["price"] = console_sales["item_price"]
console_sales["quantity"] = console_sales["item_cnt_day"]

console_required = console_sales[[
    "sale_date", "price", "category", "quantity",
    "city", "brand", "item_name",
    "item_category_name", "shop_name"
]].copy()

display(hardware_categories)
display(console_required.head())

print("Строк продаж:", len(console_required))
print(
    "Период:",
    console_required["sale_date"].min().date(),
    "—",
    console_required["sale_date"].max().date()
)
print("Городов/каналов:", console_required["city"].nunique())


